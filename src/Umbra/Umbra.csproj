<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>..\..\assets\umbra.ico</ApplicationIcon>
    <AssemblyName>Umbra</AssemblyName>
    <RootNamespace>Umbra</RootNamespace>
    <Version>1.0.0</Version>
    <Product>Umbra</Product>
    <Company>AmineChr54</Company>
    <Description>Desktop widgets that live on your wallpaper.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3351.48" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\umbra.ico" LogicalName="umbra.ico" />
    <!-- Built-in widgets ship with the app; everything else in widgets/ is installed from the community catalog. -->
    <Content Include="..\..\widgets\sp500\**\*" LinkBase="widgets\sp500" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\shared\**\*" LinkBase="shared" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\settings\**\*" LinkBase="settings" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- WebView2 ships a WPF control we do not use; dropping it avoids a WindowsBase version conflict. -->
  <Target Name="DropWebView2Wpf" AfterTargets="ResolvePackageAssets" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

</Project>
