---
import Base from "../layouts/Base.astro";
import Hero from "../components/landing/Hero.astro";
import DesktopStory from "../components/landing/DesktopStory.astro";
import Marquee from "../components/landing/Marquee.astro";
import Bento from "../components/landing/Bento.astro";
import Sandbox from "../components/landing/Sandbox.astro";
import Themes from "../components/landing/Themes.astro";
import Build from "../components/landing/Build.astro";
import Footer from "../components/landing/Footer.astro";
---

<Base title="Umbra: desktop widgets for Windows" description="Small, sharp, true-black widgets pinned under your apps on Windows. Sandboxed, scriptable and open source.">
  <main>
    <Hero />
    <DesktopStory />
    <Marquee />
    <Bento />
    <Sandbox />
    <Themes />
    <Build />
  </main>
  <Footer />
</Base>
